{
  "id": "P7OnkXnYqu22vHlL",
  "name": "PPTX-Slides: Analysis Pipeline",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "start-trigger",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst wordCount = input.word_count || 0;\nconst hasDoc = input.has_document || false;\n\nreturn [{\n  json: {\n    ...input,\n    mode: !hasDoc ? 'prompt_only' : (wordCount <= 10000 ? 'direct' : 'chunked'),\n    chunk_count: wordCount > 10000 ? Math.ceil(wordCount / 10000) : 1\n  }\n}];"
      },
      "id": "detect-mode",
      "name": "Detect Processing Mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "mode-check",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "chunked",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-chunked",
      "name": "Needs Chunking?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://analyst:8001/split-chunks",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.document_text, chunk_size: 10000, job_id: $json.job_id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-split",
      "name": "Agent: Split Chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        200
      ],
      "notesInFlow": true,
      "notes": "POST analyst:8001/split-chunks\nSplits document into 10K word chunks"
    },
    {
      "parameters": {
        "fieldToSplitOut": "chunks",
        "options": {}
      },
      "id": "split-items",
      "name": "Split Into Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Từ đoạn văn dưới đây, trích xuất cấu trúc. KHÔNG tóm tắt. CHỈ liệt kê.\\n\\nTrả về JSON:\\n{\\n  \"headings\": [\"Tiêu đề chính\"],\\n  \"topics\": [\"Chủ đề A\", \"Chủ đề B\"],\\n  \"key_entities\": [\"Tên riêng\", \"Năm\", \"Sự kiện\"],\\n  \"content_type\": \"narrative|data|argument|mixed\",\\n  \"position_hint\": \"intro|body|conclusion\"\\n}\\n\\nĐoạn văn (chunk ' + $json.chunk_index + '/' + $json.total_chunks + '):\\n' + $json.chunk_text }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1340,
        200
      ],
      "id": "llm-extract",
      "name": "LLM: Extract Metadata"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "Qwen3-32B",
          "mode": "id"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1160,
        380
      ],
      "id": "ffb8f260-a873-4877-bef6-ae4682e58d12",
      "name": "Model for LLM: Extract Metadata",
      "credentials": {
        "openAiApi": {
          "id": "6qStVbBDBo75jLqY",
          "name": "FPT CL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Gemini response → metadata\nconst response = $input.first().json;\nlet text = response.output || '{}';\ntext = text.replace(/<think>[\\s\\S]*?<\\/think>/g, \"\").trim();\n\ntry {\n  const metadata = JSON.parse(text.replace(/```json\\n?|```/g, \"\"));\n  return [{ json: { chunk_index: $('Split Into Items').item.json.chunk_index, metadata } }];\n} catch (e) {\n  // Fallback for markdown wrapped json\n  const match = text.match(/{[\\s\\S]*}/);\n  if (match) {\n    try {\n      return [{ json: { chunk_index: $('Split Into Items').item.json.chunk_index, metadata: JSON.parse(match[0]) } }];\n    } catch(e2) {}\n  }\n  return [{ json: { chunk_index: 0, metadata: { headings: [], topics: [], key_entities: [], error: e.message } } }];\n}"
      },
      "id": "parse-extract",
      "name": "Parse Extract Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "aggregate-metadata",
      "name": "Aggregate All Metadata",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1780,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://analyst:8001/merge-metadata",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id, all_metadata: $json.data }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "http-merge",
      "name": "Agent: Merge Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "notesInFlow": true,
      "notes": "POST analyst:8001/merge-metadata\nCombine metadata from all chunks"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Từ danh sách metadata các chunks dưới đây, hãy:\\n1. Tạo outline cho slide presentation\\n2. Map mỗi section tới chunk_ids chứa nội dung liên quan\\n\\nTrả về JSON:\\n{\\n  \"outline\": [{\"section_id\": 0, \"title\": \"...\", \"slides\": 2, \"key_points\": [\"...\"]}],\\n  \"chunk_mapping\": {\"0\": [0], \"1\": [1,2], \"2\": [3,4]},\\n  \"total_slides\": 15,\\n  \"topic\": \"...\",\\n  \"language\": \"vi\",\\n  \"context\": \"general|vietnam_history|tech|business\",\\n  \"theme_suggestion\": \"midnight\"\\n}\\n\\nUser prompt: ' + $json.prompt + '\\n\\nMerged metadata:\\n' + JSON.stringify($json.merged_metadata) }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        2220,
        200
      ],
      "id": "llm-outline",
      "name": "LLM: Create Outline + Mapping"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "Qwen3-32B",
          "mode": "id"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2040,
        380
      ],
      "id": "1d95cc3a-4c1b-4330-ae2d-0617f89e8b6e",
      "name": "Model for LLM: Create Outline + Mapping",
      "credentials": {
        "openAiApi": {
          "id": "6qStVbBDBo75jLqY",
          "name": "FPT CL"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Từ prompt sau, hãy tạo outline cho presentation.\\n\\nTrả về JSON:\\n{\\n  \"outline\": [{\"section_id\": 0, \"title\": \"...\", \"slides\": 2, \"key_points\": [\"...\"]}],\\n  \"chunk_mapping\": {},\\n  \"total_slides\": 10,\\n  \"topic\": \"...\",\\n  \"language\": \"vi\",\\n  \"context\": \"general\",\\n  \"theme_suggestion\": \"midnight\"\\n}\\n\\nUser prompt: ' + $json.prompt }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        900,
        420
      ],
      "id": "llm-direct",
      "name": "LLM: Direct Outline"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "Qwen3-32B",
          "mode": "id"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        720,
        600
      ],
      "id": "bfdb8061-c0aa-40b4-a398-e671f40458f6",
      "name": "Model for LLM: Direct Outline",
      "credentials": {
        "openAiApi": {
          "id": "6qStVbBDBo75jLqY",
          "name": "FPT CL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Gemini outline response (from either branch)\nconst response = $input.first().json;\nlet text = response.output || '{}';\ntext = text.replace(/<think>[\\s\\S]*?<\\/think>/g, \"\").trim();\n\ntry {\n  const result = JSON.parse(text.replace(/```json\\n?|```/g, \"\"));\n  return [{ json: { analyst_result: result } }];\n} catch (e) {\n  const match = text.match(/{[\\s\\S]*}/);\n  if (match) {\n    try {\n      return [{ json: { analyst_result: JSON.parse(match[0]) } }];\n    } catch(e2) {}\n  }\n  throw new Error('Failed to parse outline JSON: ' + e.message);\n}"
      },
      "id": "parse-outline",
      "name": "Parse Outline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Prepare final output with chunks info\nconst analystResult = $input.first().json.analyst_result;\nconst originalInput = $('Detect Processing Mode').first().json;\n\nlet chunks = [];\nif (originalInput.mode === 'chunked') {\n  try {\n    chunks = $('Agent: Split Chunks').first().json.chunks || [];\n  } catch(e) {\n    chunks = [];\n  }\n} else if (originalInput.document_text && originalInput.document_text.trim()) {\n  chunks = [originalInput.document_text];\n}\n\n// In prompt-only mode, use the prompt itself as the chunk content\n// so Writer has text to base slides on\nif (chunks.length === 0 && originalInput.prompt) {\n  chunks = [originalInput.prompt];\n}\n\nreturn [{\n  json: {\n    job_id: originalInput.job_id,\n    prompt: originalInput.prompt,\n    output_format: originalInput.output_format,\n    analyst_result: analystResult || {},\n    chunks: chunks,\n    mode: originalInput.mode || 'prompt_only',\n    word_count: originalInput.word_count || 0\n  }\n}];"
      },
      "id": "prepare-output",
      "name": "Prepare Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        300
      ]
    }
  ],
