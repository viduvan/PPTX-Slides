{
  "id": "8LVqIvaDIEpH51yk",
  "name": "PPTX-Slides: Design Pipeline",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "start-trigger",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build prompt with all slide info for layout selection\nconst slides = $json.slides;\nconst slidesSummary = slides.map((s, i) => \n  `Slide ${i+1}: \"${s.title}\" — ${(s.content || '').substring(0, 100)}...`\n).join('\\n');\n\nconst layoutList = 'cover, section-header, bullets, two-column, comparison, pros-cons, timeline, roadmap, stat-highlight, kpi-grid, quote, image-full, image-left, image-right, code, terminal, table, chart-placeholder, mindmap, pyramid, funnel, process-steps, checklist, team-grid, pricing, faq, demo, video-embed, closing, thank-you, contact';\n\nreturn [{\n  json: {\n    ...($input.first().json),\n    slides_summary: slidesSummary,\n    layout_list: layoutList\n  }\n}];"
      },
      "id": "build-prompt",
      "name": "Build Layout Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Cho mỗi slide dưới đây, chọn layout phù hợp nhất.\\n\\nDanh sách layouts: ' + $json.layout_list + '\\n\\nSlides:\\n' + $json.slides_summary + '\\n\\nTrả về JSON array: [{\"slide_index\": 0, \"layout\": \"cover\"}, {\"slide_index\": 1, \"layout\": \"bullets\"}, ...]' }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ],
      "id": "llm-layout",
      "name": "LLM: Select Layouts"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "Qwen3-32B",
          "mode": "id"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        480,
        480
      ],
      "id": "68d08507-335e-458e-be56-1594018d40dc",
      "name": "Model for LLM: Select Layouts",
      "credentials": {
        "openAiApi": {
          "id": "6qStVbBDBo75jLqY",
          "name": "FPT CL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse layout selection\nconst response = $input.first().json;\nconst text = response.output || '[]';\nlet layouts = [];\ntry { \n  layouts = JSON.parse(text.replace(/```json\\n?|```/g, \"\")); \n} catch(e) { \n  const match = text.match(/\\[[\\s\\S]*\\]/);\n  if (match) {\n    try { layouts = JSON.parse(match[0]); } catch(e2) {}\n  }\n}\nreturn [{ json: { ...($('Build Layout Prompt').first().json), layouts } }];"
      },
      "id": "parse-layouts",
      "name": "Parse Layouts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "theme-check",
              "leftValue": "={{ $json.context?.theme_suggestion }}",
              "rightValue": "auto",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "id": "if-auto-theme",
      "name": "Auto Theme?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Cho presentation về chủ đề: ' + ($json.context?.topic || 'general') + '\\nChọn 1 theme phù hợp nhất từ danh sách: midnight, ocean, forest, sunset, crimson, emerald_gold, rose, dark_purple, corporate_blue, cyber_punk, pastel_dream, aurora, volcano, arctic, desert_sand, lavender, neon_city, bamboo_zen, royal_gold, slate_minimal\\n\\nTrả về JSON: {\"theme\": \"theme_name\", \"reason\": \"lý do\"}' }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1340,
        200
      ],
      "id": "llm-theme",
      "name": "LLM: Select Theme"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "Qwen3-32B",
          "mode": "id"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1160,
        380
      ],
      "id": "723808d8-cf1a-4ede-9f1a-af2cc9684f1a",
      "name": "Model for LLM: Select Theme",
      "credentials": {
        "openAiApi": {
          "id": "6qStVbBDBo75jLqY",
          "name": "FPT CL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Use user-selected theme\nreturn [{ json: { ...($input.first().json), selected_theme: $json.context?.theme_suggestion || 'midnight' } }];"
      },
      "id": "use-user-theme",
      "name": "Use User Theme",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://designer:8003/fetch-images",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $('Start').first().json.job_id || '', slides: $('Start').first().json.slides || [], document_topic: $('Start').first().json.context?.topic || $('Start').first().json.prompt || '' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-images",
      "name": "Agent: Fetch Images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        300
      ],
      "notesInFlow": true,
      "notes": "POST designer:8003/fetch-images\nPixabay + Wikimedia Commons\nParallel image fetching"
    },
    {
      "parameters": {
        "jsCode": "// Combine layouts + theme + images → visual_specs\nconst images = $input.first().json;\nlet theme = 'midnight';\ntry {\n  theme = $('Use User Theme').first().json.selected_theme;\n} catch (e) {\n  try {\n    const llmOut = $('LLM: Select Theme').first().json.output;\n    const parsed = JSON.parse(llmOut.replace(/```json\\n?|```/g, \"\"));\n    theme = parsed.theme || 'midnight';\n  } catch (e2) {\n    theme = 'midnight';\n  }\n}\n\nreturn [{\n  json: {\n    job_id: $('Start').first().json.job_id,\n    slides: $('Start').first().json.slides,\n    output_format: $('Start').first().json.output_format,\n    visual_specs: {\n      theme: theme,\n      layouts: $('Parse Layouts').first().json.layouts,\n      images: images.image_paths || {}\n    }\n  }\n}];"
      },
      "id": "merge-specs",
      "name": "Merge Visual Specs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        300
      ]
    }
  ],
