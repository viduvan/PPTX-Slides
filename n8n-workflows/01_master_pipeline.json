      "parameters": {
        "jsCode": "// Validate input from API Gateway\nconst body = $input.first().json.body;\n\nif (!body.prompt || body.prompt.trim() === '') {\n  throw new Error('Prompt is required');\n}\n\nconst jobId = body.job_id || crypto.randomUUID();\nconst hasDocument = !!(body.document_text && body.document_text.trim().length > 0);\nconst wordCount = hasDocument ? body.document_text.split(/\\s+/).length : 0;\n\ntry {\n  $execution.metadata.set('job_id', jobId);\n} catch (e) {\n  // Ignored in test environment\n}\n\nreturn [{\n  json: {\n    job_id: jobId,\n    session_id: body.session_id,\n    prompt: body.prompt.trim(),\n    document_text: body.document_text || '',\n    has_document: hasDocument,\n    word_count: wordCount,\n    theme: body.theme || 'auto',\n    output_format: body.output_format || 'pptx'\n  }\n}];"
      },
